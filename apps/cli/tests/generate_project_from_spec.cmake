string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/generate-from-spec-${suffix}")
set(work_dir "${root}/request")
set(spec "${work_dir}/Input Spec.md")
file(MAKE_DIRECTORY "${work_dir}" "${root}/provider")
configure_file("${CMAKE_CURRENT_LIST_DIR}/project_fixture.json"
    "${root}/provider/project_fixture.json" COPYONLY)
string(REPEAT "a" 64 digest)
file(WRITE "${root}/provider/sha256-${digest}" "Synthetic local model blob")
file(READ "${root}/provider/project_fixture.json" fixture)
string(JSON base_prompt GET "${fixture}" specification)
foreach(spec_size IN ITEMS 15537 32768)
    set(destination "${work_dir}/generated project-${spec_size}")
    file(WRITE "${spec}" "${base_prompt}")
    file(SIZE "${spec}" prompt_size)
    math(EXPR padding_size "${spec_size} - ${prompt_size}")
    string(REPEAT " " ${padding_size} padding)
    file(APPEND "${spec}" "${padding}")
    if(EXISTS "${destination}")
        message(FATAL_ERROR "Generation destination should be absent before invocation")
    endif()

    execute_process(COMMAND "${EXE}" generate-project --source "${destination}" --spec "${spec}"
        --model fixture:local --curl "${CURL}" WORKING_DIRECTORY "${work_dir}" TIMEOUT 25
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code STREQUAL "0" OR NOT output MATCHES "Generated project in")
        message(FATAL_ERROR "Generation for ${spec_size} bytes returned ${code}: ${output}${error}")
    endif()

    string(JSON count LENGTH "${fixture}" files)
    math(EXPR last "${count} - 1")
    set(expected_paths)
    foreach(index RANGE ${last})
        string(JSON path GET "${fixture}" files ${index} path)
        list(APPEND expected_paths "${path}")
        string(JSON content GET "${fixture}" files ${index} content)
        string(HEX "${content}" expected_bytes)
        file(READ "${destination}/${path}" actual_bytes HEX)
        if(NOT actual_bytes STREQUAL expected_bytes)
            message(FATAL_ERROR "Generated file differs from the provider response: ${path}")
        endif()
    endforeach()
    file(GLOB_RECURSE actual_paths RELATIVE "${destination}" LIST_DIRECTORIES false "${destination}/*")
    list(SORT expected_paths)
    list(SORT actual_paths)
    if(NOT actual_paths STREQUAL expected_paths)
        message(FATAL_ERROR "Unexpected generated paths: ${actual_paths}")
    endif()
endforeach()
