get_filename_component(directory "${EXE}" DIRECTORY)
get_filename_component(extension "${EXE}" EXT)
set(name "Renamed-GREMLIN${extension}")
set(copy "${directory}/${name}")
file(COPY_FILE "${EXE}" "${copy}" ONLY_IF_DIFFERENT)
execute_process(COMMAND "${copy}" --help RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT output MATCHES "^Usage: ${name} ")
    message(FATAL_ERROR "Renamed help returned ${code}: ${output}${error}")
endif()
execute_process(COMMAND "${copy}" unknown RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 2 OR NOT error MATCHES "^${name}: invalid command")
    message(FATAL_ERROR "Renamed invalid command returned ${code}: ${output}${error}")
endif()
