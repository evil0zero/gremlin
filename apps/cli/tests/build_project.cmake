string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/gremlin-smoke/${MODE}-${suffix}")
set(source "${root}/sample source")
set(build "${root}/sample build")
set(test_name sweet_nothings.output)
if(MODE STREQUAL "scaffold")
    execute_process(COMMAND "${EXE}" init --source "${source}" --name "../invalid"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code STREQUAL "2" OR EXISTS "${source}")
        message(FATAL_ERROR "Invalid scaffold name returned ${code}: ${output}${error}")
    endif()
    execute_process(COMMAND "${EXE}" init --source "${source}" --name "demo-app"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code STREQUAL "0")
        message(FATAL_ERROR "Scaffold returned ${code}: ${output}${error}")
    endif()
    file(APPEND "${source}/CMakeLists.txt" "# Keep this local edit\n")
    file(SHA256 "${source}/CMakeLists.txt" before)
    execute_process(COMMAND "${EXE}" init --source "${source}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(SHA256 "${source}/CMakeLists.txt" after)
    if(NOT code STREQUAL "2" OR NOT before STREQUAL after)
        message(FATAL_ERROR "Scaffold over existing project returned ${code}: ${output}${error}")
    endif()
    set(test_name starter.output)
else()
    file(MAKE_DIRECTORY "${source}")
    file(COPY "${FIXTURE}/" DESTINATION "${source}")
endif()
if(MODE STREQUAL "no_tests")
    file(WRITE "${source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.21)
project(NoTests LANGUAGES CXX)
include(CTest)
add_executable(sweet_nothings main.cpp)
]=])
endif()

set(args --source "${source}" --cmake "${CMAKE_TOOL}" --ctest "${CTEST_TOOL}"
    --ninja "${NINJA_TOOL}" --compiler "${COMPILER}" --profile "${PROFILE}")

if(MODE STREQUAL "out_of_source")
    execute_process(COMMAND "${EXE}" build ${args} --build-dir "${build}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code STREQUAL "4" OR EXISTS "${build}")
        message(FATAL_ERROR "Missing trust flag returned ${code}: ${output}${error}")
    endif()
    execute_process(COMMAND "${EXE}" build --trust-source ${args} --build-dir "${source}/unwanted"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code STREQUAL "2" OR EXISTS "${source}/unwanted")
        message(FATAL_ERROR "In-source request returned ${code}: ${output}${error}")
    endif()
endif()

execute_process(COMMAND "${EXE}" build --trust-source ${args} --build-dir "${build}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
message("Build evidence: ${build}/gremlin-logs")
if(MODE STREQUAL "no_tests")
    if(NOT code STREQUAL "6" OR NOT error MATCHES "tests exited")
        message(FATAL_ERROR "Expected test failure for an empty suite, got ${code}: ${output}${error}")
    endif()
    file(READ "${build}/gremlin-logs/test.log" test_log)
    if(NOT test_log MATCHES "No tests were found")
        message(FATAL_ERROR "Expected zero-test diagnostic: ${test_log}")
    endif()
    return()
endif()

if(NOT code STREQUAL "0" OR EXISTS "${source}/CMakeCache.txt" OR NOT EXISTS "${build}/CMakeCache.txt")
    message(FATAL_ERROR "Out-of-source build returned ${code}: ${output}${error}")
endif()
file(READ "${build}/gremlin-logs/junit.xml" junit)
if(NOT junit MATCHES "name=\"${test_name}\"" OR NOT junit MATCHES "failures=\"0\"")
    message(FATAL_ERROR "Expected successful application acceptance test: ${junit}")
endif()
if(MODE STREQUAL "scaffold")
    set(app "${build}/bin/demo-app")
    if(WIN32)
        string(APPEND app ".exe")
    endif()
    if(NOT EXISTS "${app}")
        message(FATAL_ERROR "Expected named executable at ${app}")
    endif()
endif()
